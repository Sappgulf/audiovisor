# Spotify is optional; use the Connect panel or bake in a default Client ID.
VITE_SPOTIFY_CLIENT_ID=

# Apple Music server token endpoint. Keep the private key in Vercel env only.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_ORIGIN=

# Optional local-only fallback. This signed token is public; never put the
# Apple Developer private key in this file or in the browser bundle.
VITE_APPLE_MUSIC_DEVELOPER_TOKEN=
