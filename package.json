{
  "name": "audiovisor",
  "private": true,
  "version": "8.15.1",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate",
    "size": "node scripts/check-size.mjs",
    "shots": "node scripts/render-screens.mjs",
    "og": "node scripts/make-og.mjs",
    "icons": "node scripts/make-icons.mjs",
    "analyze": "node scripts/analyze-shots.mjs",
    "thumbs": "node scripts/make-thumbs.mjs",
    "sweep": "node scripts/sweep.mjs",
    "bench": "node scripts/live-bench.mjs",
    "rayshots": "node scripts/ray-shots.mjs",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.9",
    "@shaderfrog/glsl-parser": "^7.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
